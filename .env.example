# Copie para .env e preencha. O .env NÃO é versionado.
# Nenhum segredo entra em código ou em application.yml.

# --- Banco ---------------------------------------------------------------
# Duas roles distintas de propósito: a dona das tabelas roda as migrations,
# a da aplicação sofre Row Level Security. Ver ADR 0001, seção 5.
JUSPRISMA_DB_URL=jdbc:postgresql://localhost:5432/jusprisma
JUSPRISMA_DB_USER=jusprisma_app
JUSPRISMA_DB_PASSWORD=troque-me
JUSPRISMA_DB_MIGRATION_USER=jusprisma_owner
JUSPRISMA_DB_MIGRATION_PASSWORD=troque-me

# Usados pelo docker-compose para inicializar o Postgres
POSTGRES_DB=jusprisma
POSTGRES_USER=jusprisma_owner
POSTGRES_PASSWORD=troque-me

# --- Aplicação -----------------------------------------------------------
JUSPRISMA_PORT=8080

# --- E-mail (mailhog no dev) --------------------------------------------
JUSPRISMA_MAIL_HOST=localhost
JUSPRISMA_MAIL_PORT=1025

# --- Autenticação --------------------------------------------------------
# Segredo de assinatura do JWT. Gere com: openssl rand -base64 64
JUSPRISMA_JWT_SECRET=
# Em dev sobre http o cookie de renovacao nao pode ser Secure, senao o navegador o recusa.
# NUNCA use false fora de desenvolvimento.
JUSPRISMA_COOKIE_SEGURO=false

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- DataJud (CNJ) -------------------------------------------------------
# Chave obtida em cnj.jus.br/sistemas/datajud/api-publica/
JUSPRISMA_DATAJUD_API_KEY=

# --- Asaas ---------------------------------------------------------------
JUSPRISMA_ASAAS_API_KEY=
JUSPRISMA_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que valida a origem dos webhooks
JUSPRISMA_ASAAS_WEBHOOK_TOKEN=
